<Project Sdk="Microsoft.NET.Sdk">

  <!-- Консольный приёмочный проект (этап 11): прогон критериев A/B на Windows + Excel.
       Multi-target net472;net5.0-windows — как у библиотеки, чтобы проверить рантайм
       AnyCPU-потребителя с x86/x64 Office (критерий A.2). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net472;net5.0-windows</TargetFrameworks>
    <LangVersion>9</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <RootNamespace>ExcelLibrary.Acceptance</RootNamespace>
    <AssemblyName>ExcelLibrary.Acceptance</AssemblyName>
    <!-- Приёмочный консольник не требует XML-документации по всему API -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ExcelLibrary.ComInterop/ExcelLibrary.ComInterop.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="System.Text.Json" Version="8.0.0" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

</Project>
