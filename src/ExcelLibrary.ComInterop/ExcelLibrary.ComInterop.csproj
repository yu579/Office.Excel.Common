<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Библиотека работает через Excel COM Interop, поэтому требует Windows -->
    <TargetFrameworks>net472;net5.0-windows</TargetFrameworks>
    <LangVersion>9</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
    <UseWindowsForms>false</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>ExcelLibrary.ComInterop</RootNamespace>
    <AssemblyName>ExcelLibrary.ComInterop</AssemblyName>
    <Version>0.1.0</Version>
    <Description>Библиотека для работы с Excel через COM Interop: шаблоны, пагинация листов, печать, PDF.</Description>
    <Company>ExcelLibrary</Company>
    <!-- Публичный API не должен зависеть от типов PIA: используется late binding как fallback -->
    <EmbedInteropTypes>false</EmbedInteropTypes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Primary Interop Assembly Excel 15.x (COM-взаимодействие) -->
    <PackageReference Include="Microsoft.Office.Interop.Excel" Version="15.0.4795.1001" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <!-- JSON-сериализация для net472 (п.3 ТЗ: загрузка данных из JSON) -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <!-- RuntimeBinder для dynamic (late binding COM) в .NET Framework -->
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net472'">
    <!-- Реестр Windows (определение пути Excel.exe / битности) в .NET Core/5+ -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

</Project>
